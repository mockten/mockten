# Dead root-level frontend scaffolding (a Figma Make export; the real frontend
# is ecfront/). Ignored at the repo root only so ecfront/* is unaffected.
/package.json
/vite.config.ts
/index.html

# Go workspace file — a local multi-module dev convenience only. CI/Docker build
# each module independently (cart resolves common via a go.mod replace), so this
# is not committed. Regenerate locally with:
#   go work init ./cart ./common ./ecpay ./geocoding ./product ./ranking ./sale ./searchitem ./shipment
/go.work
/go.work.sum

**/__pycache__/
*.pyc

# Python virtualenvs (e.g. mysql/seeder/venv). `python -m venv` also drops its
# own `.gitignore` with `*` inside, but ignore them explicitly here too so a venv
# created any other way can never be committed.
venv/
**/venv/
.venv/
**/.venv/
# Compiled Go service binaries (produced by `go build`; named after their module/dir)
sale/sale
shipment/shipment
cart/cart
ranking/ranking
product/product
ecpay/ecpay
searchitem/searchitem
geocoding/nominatim-geocode-svc
.agent/
