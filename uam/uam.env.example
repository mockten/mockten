# uam (Keycloak) OAuth secrets — local development template.
#
# Copy this file to `uam.env` (which is gitignored) and fill in the values from
# your Google Cloud / Meta developer console. These are injected into the realm
# import at container startup by docker-entrypoint.sh; they are NEVER baked into
# the Docker image, so the pushed image contains no credentials.
#
# Leave a value blank to disable that provider — the app still boots, only that
# social login is unavailable.
#
# In Kubernetes, do NOT use this file. Provide the same four keys through a
# Secret and reference it from the uam Deployment with `envFrom: [secretRef]`.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
